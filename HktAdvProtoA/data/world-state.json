      "then_off": [ { "var": "S_일식.활성", "op": "set", "value": false } ] },
    { "id": "CLOCK_별빛폭풍", "basis": "§5.4 주기 발생 위협. 뇌철 결정 안정 시한의 전제",
      "period": 300, "duty": 30,
      "then_on": [ { "var": "X_별빛폭풍.활성", "op": "set", "value": true } ],
      "then_off": [ { "var": "X_별빛폭풍.활성", "op": "set", "value": false } ] }
  ],

  "subjects": [
    { "node": "E_플레이어", "driver": "input" },
    { "node": "F_씨앗보존회", "driver": "policy", "policy": ["G1.2.6"] },
    { "node": "F_청동수문회", "driver": "policy", "policy": ["G_수문회_제어탑파괴"] }
  ],

  "rules": [
    { "id": "RULE_강귀환_1", "basis": "EV_강의귀환 1단계 · 그래프: L_제어탑 ─변화→ S_강흐름",
      "when": { "all": [
        { "var": "L_제어탑.가동", "op": "==", "value": true },
        { "var": "EV_강의귀환.단계", "op": "==", "value": 0 }
      ] },
      "then": [
        { "var": "S_강흐름.단계", "op": "add", "value": 2 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 1 }
      ], "once": true },

    { "id": "RULE_강귀환_2", "basis": "EV_강의귀환 2단계 · 그래프: S_강흐름 ─변화→ L_굶주린평원",
      "when": { "all": [
        { "var": "S_강흐름.단계", "op": ">=", "value": 2 },
        { "var": "EV_강의귀환.단계", "op": "==", "value": 1 }
      ] },
      "then": [
        { "var": "L_굶주린평원.생산", "op": "add", "value": 2 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 2 }
      ], "once": true },

    { "id": "RULE_강귀환_3", "basis": "EV_강의귀환 3단계 · 그래프: L_굶주린평원 ─제공→ R_식량",
      "when": { "all": [
        { "var": "L_굶주린평원.생산", "op": ">=", "value": 2 },
        { "var": "EV_강의귀환.단계", "op": "==", "value": 2 }
      ] },
      "then": [
        { "var": "R_식량.공급", "op": "add", "value": 2 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 3 }
      ], "once": true },

    { "id": "RULE_강귀환_4", "basis": "EV_강의귀환 4단계 · 그래프: R_식량 ─방해→ F_청동수문회(권력 약화)",
      "when": { "all": [
        { "var": "R_식량.공급", "op": ">=", "value": 3 },
        { "var": "EV_강의귀환.단계", "op": "==", "value": 3 }
      ] },
      "then": [
        { "var": "F_청동수문회.세력", "op": "add", "value": -2 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 4 }
      ], "once": true },

    { "id": "RULE_강귀환_5", "basis": "EV_강의귀환 5단계 · 세력 목적의 발견(§5.5) — NPC 가 이어받는다",
      "when": { "all": [
        { "var": "F_청동수문회.세력", "op": "<=", "value": 1 },
        { "var": "EV_강의귀환.단계", "op": "==", "value": 4 }
      ] },
      "then": [
        { "var": "EV_강의귀환.단계", "op": "set", "value": 5 }
      ], "once": true },

    { "id": "RULE_늪서식지_감소", "basis": "EV_강의귀환 7단계 · 그래프: E_카르마 ─충돌→ E_늪생명체 (강 복구=고수위, 늪은 저수위 선호)",
      "when": { "all": [
        { "var": "S_강흐름.단계", "op": ">=", "value": 2 }
      ] },
      "then": [
        { "var": "E_늪생명체.서식", "op": "add", "value": -1 }
      ], "once": true },

    { "id": "RULE_숲_회복", "basis": "그래프: S_강흐름 ─변화→ L_굶주린평원 파생 — 강 회복이 재의 숲 먹이를 되살린다",
      "when": { "all": [
        { "var": "S_강흐름.단계", "op": ">=", "value": 2 }
      ] },
      "then": [
        { "var": "L_재의숲.먹이", "op": "add", "value": 1 }
      ], "once": false },

    { "id": "RULE_늑대_기근", "basis": "그래프: E_카르마 ─변화→ X_늑대공격 (숲 고사→먹이 고갈→늑대 아사). 무입력 자율 변화(검증 13)",
      "when": { "all": [
        { "var": "L_재의숲.먹이", "op": "<=", "value": 0 },
        { "var": "E_회색등늑대.개체수", "op": ">", "value": 0 }
      ] },
      "then": [
        { "var": "E_회색등늑대.개체수", "op": "add", "value": -1 }
      ], "once": false },

    { "id": "C2_1", "basis": "EV: EV_늑대멸종 단계 1 (WorldLaws C2-1) — 늑대 소수화로 마을 공격 소멸",
      "when": { "all": [
        { "var": "E_회색등늑대.개체수", "op": "<=", "value": 5 },
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 0 }
      ] },
      "then": [ { "var": "EV_늑대멸종.단계", "op": "set", "value": 1 } ], "once": true },

    { "id": "A1_초식급증", "basis": "REL: E_회색등늑대 ─방해→ E_초식동물 (포식 압력 소멸 → 초식 급증). P3 생태",
      "when": { "all": [
        { "var": "E_회색등늑대.개체수", "op": "<=", "value": 5 },
        { "var": "E_초식동물.개체수", "op": "<", "value": 15 }
      ] },
      "then": [ { "var": "E_초식동물.개체수", "op": "add", "value": 1 } ], "every": 1 },

    { "id": "C2_2", "basis": "EV: EV_늑대멸종 단계 2 (WorldLaws C2-2) — 초식동물 급증",
      "when": { "all": [
        { "var": "E_초식동물.개체수", "op": ">=", "value": 15 },
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 1 }
      ] },
      "then": [ { "var": "EV_늑대멸종.단계", "op": "set", "value": 2 } ], "once": true },

    { "id": "A2_과방목", "basis": "REL: E_초식동물 ─방해→ L_재의숲 (과방목으로 어린 숲 식생 소실). P3 생태",
      "when": { "all": [
        { "var": "E_초식동물.개체수", "op": ">=", "value": 15 },
        { "var": "L_재의숲.식생", "op": ">", "value": 0 }
      ] },
      "then": [ { "var": "L_재의숲.식생", "op": "add", "value": -1 } ], "every": 1 },

    { "id": "C2_3", "basis": "EV: EV_늑대멸종 단계 3 (WorldLaws C2-3) — 어린 숲 소멸",
      "when": { "all": [
        { "var": "L_재의숲.식생", "op": "<=", "value": 0 },
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 2 }
      ] },
      "then": [ { "var": "EV_늑대멸종.단계", "op": "set", "value": 3 } ], "once": true },

    { "id": "C2_4", "basis": "EV: EV_늑대멸종 단계 4 (WorldLaws C2-4) — 식생 소실로 S_토양침식(파생) 활성",
      "when": { "all": [
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 3 }
      ] },
      "then": [
        { "var": "EV_늑대멸종.단계", "op": "set", "value": 4 }
      ], "once": true },

    { "id": "A3_토사퇴적", "basis": "REL: S_토양침식 ─변화→ S_강흐름 (토사 퇴적·수로 막힘). P2 압력 — 사건 1 의 중심 변수와 교차(§6)",
      "when": { "all": [
        { "var": "S_토양침식.활성", "op": "==", "value": true },
        { "var": "S_강흐름.단계", "op": ">", "value": 0 }
      ] },
      "then": [ { "var": "S_강흐름.단계", "op": "add", "value": -1 } ], "every": 2 },

    { "id": "C2_5", "basis": "EV: EV_늑대멸종 단계 5 (WorldLaws C2-5) — 강 토사 퇴적·수로 막힘",
      "when": { "all": [
        { "var": "S_강흐름.단계", "op": "<=", "value": 0 },
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 4 }
      ] },
      "then": [ { "var": "EV_늑대멸종.단계", "op": "set", "value": 5 } ], "once": true },

    { "id": "C2_6", "basis": "EV: EV_늑대멸종 단계 6 (WorldLaws C2-6) — 사건이 새 목적(늑대 복원)을 발견시킨다",
      "when": { "all": [
        { "var": "EV_늑대멸종.단계", "op": "==", "value": 5 }
      ] },
      "then": [
        { "var": "G_늑대복원.진행", "op": "set", "value": 1 },
        { "var": "EV_늑대멸종.단계", "op": "set", "value": 6 }
      ], "once": true },

    { "id": "LAW_포식", "basis": "REL: E_회색등늑대 ─방해→ E_초식동물 (포식 압력 회복 시 초식 억제). A1 의 반대 방향 — 포식-피식 균형",
      "when": { "all": [
        { "var": "E_회색등늑대.개체수", "op": ">=", "value": 10 },
        { "var": "E_초식동물.개체수", "op": ">", "value": 0 }
      ] },
      "then": [ { "var": "E_초식동물.개체수", "op": "add", "value": -1 } ], "every": 2 },

    { "id": "LAW_B_식생회복", "basis": "균형 LAW-B03 — 방목 압력이 사라지면(초식 감소) 어린 숲 식생 회복. A2 과방목의 회복 짝(§6)",
      "when": { "all": [
        { "var": "E_초식동물.개체수", "op": "<=", "value": 10 },
        { "var": "L_재의숲.식생", "op": "<", "value": 3 }
      ] },
      "then": [ { "var": "L_재의숲.식생", "op": "add", "value": 1 } ], "every": 3 },

    { "id": "LAW_B_늑대회복", "basis": "균형 LAW-B02 — 먹이 충분 시 늑대 개체군 회복. RULE_늑대_기근의 회복 짝(§6)",
      "when": { "all": [
        { "var": "E_회색등늑대.개체수", "op": ">", "value": 0 },
        { "var": "E_회색등늑대.개체수", "op": "<", "value": 40 },
        { "var": "L_재의숲.먹이", "op": ">=", "value": 2 }
      ] },
      "then": [ { "var": "E_회색등늑대.개체수", "op": "add", "value": 1 } ], "every": 5 },

    { "id": "LAW_B_늪회복", "basis": "균형 — 저수위 회복 시 늪 서식지 회복. RULE_늪서식지_감소의 회복 짝(§6)",
      "when": { "all": [
        { "var": "S_강흐름.단계", "op": "<=", "value": 1 },
        { "var": "E_늪생명체.서식", "op": "<", "value": 2 }
      ] },
      "then": [ { "var": "E_늪생명체.서식", "op": "add", "value": 1 } ], "every": 4 }
  ],

  "actions": [
    { "id": "ACT_제어탑_복구", "objective": "G1.2.6",
      "actor_type": ["E_플레이어", "F_씨앗보존회"],
      "basis": "그래프: G1.2.6 ─필요→ K_관개시설기록·L_제어탑 · EV_강의귀환 1단계",
      "when": { "all": [
        { "var": "{actor}.습득.K_관개시설기록", "op": "==", "value": true },
        { "var": "L_제어탑.발견", "op": "==", "value": true },
        { "var": "L_제어탑.가동", "op": "==", "value": false }
      ] },
      "cost": [ { "var": "{actor}.보유.R_재생섬유", "op": "add", "value": -3 } ],
      "then": [
        { "var": "L_제어탑.가동", "op": "set", "value": true },
        { "var": "G1.2.6.완료방식", "op": "set", "value": "ACT_제어탑_복구" }
      ], "duration": 5, "once": true },

    { "id": "ACT_카르마_길들임", "objective": "G1.2.6",
      "actor_type": ["E_플레이어"],
      "basis": "G1.2.6.3 해결 방법 '일부만 방출하도록 길들임' · 그래프: E_카르마 ─제공→ R_수분핵",
      "when": { "all": [
        { "var": "{actor}.보유.R_수분핵", "op": ">=", "value": 2 },
        { "var": "S_강흐름.단계", "op": "<", "value": 2 }
      ] },
      "cost": [ { "var": "{actor}.보유.R_수분핵", "op": "add", "value": -2 } ],
      "then": [
        { "var": "E_카르마.서식", "op": "add", "value": -1 },
        { "var": "S_강흐름.단계", "op": "add", "value": 2 },
        { "var": "G1.2.6.완료방식", "op": "set", "value": "ACT_카르마_길들임" }
      ], "duration": 3, "once": true },

    { "id": "ACT_붉은뿌리_제거", "objective": "G1.2.6",
      "actor_type": ["E_플레이어"],
      "basis": "G1.2.6.3 해결 방법 '붉은 뿌리 제거' · node detail 문제 '단순 제거 시 대홍수 발생'",
      "when": { "all": [
        { "var": "{actor}.보유.R_재생섬유", "op": ">=", "value": 1 },
        { "var": "S_강흐름.단계", "op": "<", "value": 2 }
      ] },
      "then": [
        { "var": "E_카르마.서식", "op": "set", "value": 0 },
        { "var": "S_강흐름.단계", "op": "set", "value": 3 },
        { "var": "G1.2.6.완료방식", "op": "set", "value": "ACT_붉은뿌리_제거" }
      ], "duration": 1, "once": true },

    { "id": "ACT_늑대_사냥", "objective": "G2.1",
      "actor_type": ["E_플레이어"],
      "basis": "EV_늑대멸종 1단계 '대량 사냥' · 그래프: X_늑대공격 ─방해→ G1.5",
      "when": { "all": [
        { "var": "E_회색등늑대.개체수", "op": ">", "value": 0 }
      ] },
      "then": [
        { "var": "E_회색등늑대.개체수", "op": "add", "value": -35 },
        { "var": "G2.1.완료방식", "op": "set", "value": "ACT_늑대_사냥" }
      ], "duration": 1, "once": true },

    { "id": "ACT_늑대_계약", "objective": "G2.1",
      "actor_type": ["E_플레이어"],
      "basis": "그래프: G6.2 ─제공→ E_회색등늑대 — 계약으로 습격을 멈춘다(설계 §7: 설계에 없던 해결 경로도 상태 술어로 완료)",
      "when": { "all": [
        { "var": "{actor}.보유.R_수분핵", "op": ">=", "value": 1 }
      ] },
      "cost": [ { "var": "{actor}.보유.R_수분핵", "op": "add", "value": -1 } ],
      "then": [
        { "var": "E_플레이어.계약.E_회색등늑대", "op": "set", "value": true },
        { "var": "G2.1.완료방식", "op": "set", "value": "ACT_늑대_계약" }
      ], "duration": 1, "once": true },

    { "id": "ACT_수문회_제어탑파괴", "objective": "G_수문회_제어탑파괴",
      "actor_type": ["F_청동수문회"],
      "basis": "EV_강의귀환 6단계 · node detail 보유 '무장 운송대' — 제어탑 습격 파괴",
      "when": { "all": [
        { "var": "F_청동수문회.세력", "op": ">=", "value": 1 },
        { "var": "L_제어탑.가동", "op": "==", "value": true }
      ] },
      "then": [
        { "var": "L_제어탑.가동", "op": "set", "value": false },
        { "var": "S_강흐름.단계", "op": "add", "value": -2 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 6 },
        { "var": "G_수문회_제어탑파괴.완료방식", "op": "set", "value": "ACT_수문회_제어탑파괴" }
      ], "duration": 2, "once": true },

    { "id": "ACT_수문회_수문봉쇄", "objective": "G_수문회_제어탑파괴",
      "actor_type": ["F_청동수문회"],
      "basis": "node detail 보유 '수문 열쇠·수로 지도' — 관개 시설 재봉쇄로 강 흐름 차단",
      "when": { "all": [
        { "var": "F_청동수문회.세력", "op": ">=", "value": 1 },
        { "var": "S_강흐름.단계", "op": ">=", "value": 2 }
      ] },
      "then": [
        { "var": "S_강흐름.단계", "op": "add", "value": -1 },
        { "var": "EV_강의귀환.단계", "op": "set", "value": 6 },
        { "var": "G_수문회_제어탑파괴.완료방식", "op": "set", "value": "ACT_수문회_수문봉쇄" }
      ], "duration": 2, "once": true },

