{
  "normalize_themes": [
    {
      "id": "theme.sustain_what_matters",
      "source": "모든 생명은 자신이 중요하게 여기는 존재를 지속시키려 한다.",
      "subject": "living_being",
      "behavior": "sustain_valued_existence",
      "desiredState": "valued_existence_persists",
      "threat": "loss_of_valued_existence",
      "scope": "world"
    },
    {
      "id": "theme.restriction_grants_power",
      "source": "인간은 자신의 욕망에 명확한 제약을 걸어 초월적인 능력을 사용할 수 있다.",
      "subject": "human",
      "condition": "self_imposed_restriction_on_desire",
      "behavior": "use_transcendent_ability",
      "cost": "restriction_binds_the_user",
      "scope": "species"
    },
    {
      "id": "theme.strong_restriction_strong_backlash",
      "source": "강한 제약은 강한 능력을 만들지만, 제약을 어기면 심각한 반동을 받는다.",
      "subject": "ability",
      "condition": "restriction_strength",
      "desiredState": "ability_output_scales_with_restriction",
      "cost": "severe_backlash_on_violation",
      "scope": "individual"
    },
    {
      "id": "theme.wilds_absorb_traces",
      "source": "문명 밖에는 능력의 흔적을 흡수해 적응하는 생물들이 존재한다.",
      "subject": "wild_creature",
      "condition": "ability_residue_present",
      "behavior": "absorb_and_adapt",
      "threat": "unknown_adaptive_life_outside_civilization",
      "scope": "species"
    },
    {
      "id": "theme.danger_holds_growth",
      "source": "위험한 지역에서만 능력을 성장시킬 희귀 자원을 얻을 수 있다.",
      "subject": "world_resource_distribution",
      "condition": "high_environmental_danger",
      "desiredState": "rare_growth_resources_only_in_danger",
      "scope": "world"
    }
  ],
  "axioms": [
    {
      "id": "axiom.life_must_be_sustained",
      "statement": "모든 생명은 자신의 몸과 에너지를 유지해야 한다. 유지에 실패하면 소멸한다.",
      "category": "survival",
      "immutable": true,
      "derivedFrom": [
        "theme.sustain_what_matters"
      ]
    },
    {
      "id": "axiom.life_protects_what_it_values",
      "statement": "모든 생명은 자신이 생존 단위로 인식하는 대상을 지속시키려 한다.",
      "category": "survival",
      "immutable": true,
      "derivedFrom": [
        "theme.sustain_what_matters"
      ]
    },
    {
      "id": "axiom.power_restriction",
      "statement": "인간의 초월적 능력은 스스로 받아들인 제약에 의해 증폭된다.",
      "category": "power",
      "immutable": true,
      "derivedFrom": [
        "theme.restriction_grants_power"
      ]
    },
    {
      "id": "axiom.power_cost",
      "statement": "강한 능력은 강한 제약을 요구하고, 제약을 어기면 반동이 돌아온다.",
      "category": "cost",
      "immutable": true,
      "derivedFrom": [
        "theme.strong_restriction_strong_backlash",
        "theme.restriction_grants_power"
      ]
    },
    {
      "id": "axiom.dangerous_places_are_rich",
      "statement": "위험이 높은 지역일수록 희귀한 생명과 자원이 존재할 가능성이 높다.",
      "category": "ecology",
      "immutable": true,
      "derivedFrom": [
        "theme.danger_holds_growth"
      ]
    },
    {
      "id": "axiom.creatures_absorb_ability_residue",
      "statement": "문명 밖의 생물은 능력이 남긴 흔적을 흡수해 자신을 적응시킨다.",
      "category": "ecology",
      "immutable": true,
      "derivedFrom": [
        "theme.wilds_absorb_traces"
      ]
    },
    {
      "id": "axiom.scarcity_creates_exchange",
      "statement": "희소한 자원은 그것을 필요로 하는 주체들 사이에 교환과 통제를 만든다.",
      "category": "society",
      "immutable": true,
      "derivedFrom": [
        "theme.danger_holds_growth",
        "theme.sustain_what_matters"
      ]
    },
    {
      "id": "axiom.organizations_act_on_reports",
      "statement": "조직은 세계를 직접 보지 못한다. 구성원의 보고가 조직의 판단 근거다.",
      "category": "information",
      "immutable": true,
      "derivedFrom": [
        "theme.sustain_what_matters"
      ]
    },
    {
      "id": "axiom.belief_drives_behavior",
      "statement": "주체는 실제 상태가 아니라 자신이 믿는 상태에 따라 판단한다.",
      "category": "information",
      "immutable": true,
      "derivedFrom": [
        "theme.sustain_what_matters"
      ]
    },
    {
      "id": "axiom.actions_leave_signs",
      "statement": "모든 행동은 관찰 가능한 흔적을 남긴다. 흔적은 사라지지만 즉시 사라지지는 않는다.",
      "category": "information",
      "immutable": true,
      "derivedFrom": [
        "theme.wilds_absorb_traces",
        "theme.restriction_grants_power"
      ]
    }
  ],
