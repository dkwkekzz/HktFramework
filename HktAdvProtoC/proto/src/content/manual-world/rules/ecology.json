  {
    "id": "rule.attack_resolution",
    "name": "공격 판정",
    "scope": "relationship",
    "priority": 50,
    "triggers": [
      {
        "type": "action_executed",
        "actionId": "action.attack"
      }
    ],
    "bindings": [
      {
        "name": "damage",
        "value": {
          "type": "expr",
          "op": "add",
          "operands": [
            {
              "type": "constant",
              "value": 15
            },
            {
              "type": "random_int",
              "max": 10,
              "stream": "actor"
            }
          ]
        }
      }
    ],
    "conditions": [],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "target"
        },
        "stateKey": "health",
