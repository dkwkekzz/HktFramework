          "type": "expr",
          "op": "neg",
          "operands": [
            {
              "type": "binding",
              "name": "damage"
            }
          ]
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "target"
        },
        "stateKey": "fear",
        "operation": "add",
        "value": 25
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.life_protects_what_it_values"
    ]
  },
  {
    "id": "rule.echo_beast_reproduction",
    "name": "반향수 번식 — 새끼가 태어난다",
    "scope": "region",
    "priority": 30,
    "triggers": [
      {
        "type": "interval",
        "interval": 7200
      }
    ],
    "conditions": [
      {
        "left": {
          "type": "entity_state",
          "entityId": "creature.echo_beast_mother",
          "key": "health"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 60
        }
      },
      {
        "left": {
          "type": "entity_state",
          "entityId": "creature.echo_beast_mother",
          "key": "hunger"
        },
        "operator": "<",
        "right": {
          "type": "constant",
          "value": 55
        }
      },
      {
        "left": {
          "type": "query_value",
          "query": {
            "tags": [
              "echo_beast_cub"
            ]
          },
          "aggregate": "count"
        },
        "operator": "<",
        "right": {
          "type": "constant",
          "value": 1
        }
      }
    ],
    "effects": [
      {
        "type": "create_entity",
        "templateId": "creature.echo_beast_cub",
        "location": {
          "type": "entity",
          "entityId": "location.beast_den"
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "entity",
          "entityId": "creature.echo_beast_mother"
        },
        "stateKey": "offspring_threat",
        "operation": "add",
        "value": 5
      },
      {
        "type": "modify_state",
        "target": {
          "type": "entity",
          "entityId": "creature.echo_beast_mother"
        },
        "stateKey": "energy",
        "operation": "add",
        "value": -15
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.life_must_be_sustained",
      "axiom.life_protects_what_it_values"
    ]
  },
