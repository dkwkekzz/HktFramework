[
  {
    "id": "rule.forest_resource_regrowth",
    "name": "침묵림 자원 재생",
    "scope": "region",
    "priority": 80,
    "triggers": [
      {
        "type": "interval",
        "interval": 360
      }
    ],
    "conditions": [],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "query",
          "query": {
            "entityType": "resource",
            "tags": [
              "harvestable"
            ]
          }
        },
        "stateKey": "amount",
        "operation": "add",
        "valueRef": {
          "type": "each_state",
          "key": "regrowth"
        }
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
