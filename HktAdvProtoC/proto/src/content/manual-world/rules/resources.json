      "ability_residue",
      "survival",
      "overuse"
    ],
    "scope": "global",
    "priority": 55,
    "triggers": [
      {
        "type": "interval",
        "interval": 60
      }
    ],
    "conditions": [],
    "effects": [
      {
        "type": "modify_state",
        "conditions": [
          {
            "left": {
              "type": "each_state",
              "key": "species_id"
            },
            "operator": "==",
            "right": {
              "type": "constant",
              "value": "species.human"
            }
          },
          {
            "left": {
              "type": "each_state",
              "key": "carried_residue"
            },
            "operator": ">",
            "right": {
              "type": "constant",
              "value": 3
            }
          }
        ],
        "target": {
          "type": "query",
          "query": {
            "entityType": "agent"
          }
        },
        "stateKey": "health",
        "operation": "add",
        "value": -4
      },
      {
        "type": "modify_state",
        "conditions": [
          {
            "left": {
              "type": "each_state",
              "key": "species_id"
            },
            "operator": "==",
            "right": {
              "type": "constant",
              "value": "species.human"
            }
          },
          {
            "left": {
              "type": "each_state",
              "key": "carried_residue"
            },
            "operator": ">",
            "right": {
              "type": "constant",
              "value": 3
            }
          }
        ],
        "target": {
          "type": "query",
          "query": {
            "entityType": "agent"
          }
        },
        "stateKey": "carried_residue",
        "operation": "add",
        "value": -1
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.creatures_absorb_ability_residue"
    ]
  },
  {
    "id": "rule.market_glut",
