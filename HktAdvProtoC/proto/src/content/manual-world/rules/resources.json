  {
    "id": "rule.village_food_consumption",
    "name": "마을 식량 소비",
    "scope": "global",
    "priority": 80,
    "triggers": [
      {
        "type": "interval",
        "interval": 1440
      }
    ],
    "forEach": {
      "type": "query",
      "query": {
        "entityType": "faction"
      }
    },
    "bindings": [
      {
        "name": "need",
        "value": {
          "type": "expr",
          "op": "mul",
          "operands": [
            {
              "type": "target_state",
              "key": "member_count"
            },
            {
              "type": "constant",
              "value": 1.2
            }
          ]
        }
      },
      {
        "name": "taken",
        "value": {
          "type": "expr",
          "op": "min",
          "operands": [
            {
              "type": "binding",
              "name": "need"
            },
            {
              "type": "target_state",
              "key": "food_reserve"
            }
          ]
        }
      },
      {
        "name": "ration",
        "value": {
          "type": "expr",
          "op": "mul",
          "operands": [
            {
              "type": "expr",
              "op": "div",
              "operands": [
                {
                  "type": "binding",
                  "name": "taken"
                },
                {
                  "type": "binding",
                  "name": "need"
                }
              ]
            },
            {
              "type": "constant",
              "value": 26
            }
          ]
        }
      }
    ],
    "conditions": [
      {
        "left": {
          "type": "binding",
          "name": "need"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 0
        }
      },
      {
        "left": {
          "type": "binding",
          "name": "taken"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 0
        }
      }
    ],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "target"
        },
        "stateKey": "food_reserve",
        "operation": "add",
        "valueRef": {
          "type": "expr",
          "op": "neg",
          "operands": [
            {
              "type": "binding",
              "name": "taken"
            }
          ]
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "query",
          "query": {
            "entityType": "agent",
            "where": [
              {
                "left": {
                  "type": "each_state",
                  "key": "faction_id"
                },
                "operator": "==",
                "right": {
                  "type": "entity_ref",
                  "of": "target"
                }
              }
            ]
          }
        },
        "stateKey": "hunger",
        "operation": "add",
        "valueRef": {
          "type": "expr",
          "op": "neg",
          "operands": [
            {
              "type": "binding",
              "name": "ration"
            }
          ]
        }
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.life_must_be_sustained"
    ]
  },
  {
    "id": "rule.hunt_yield",
    "name": "사냥 산출",
    "scope": "entity",
    "priority": 50,
    "triggers": [
