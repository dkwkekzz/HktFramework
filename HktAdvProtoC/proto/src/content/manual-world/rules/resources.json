      },
      {
        "type": "action_executed",
        "actionId": "action.forage"
      }
    ],
    "bindings": [
      {
        "name": "attempt",
        "value": {
          "type": "expr",
          "op": "add",
          "operands": [
            {
              "type": "constant",
              "value": 12
            },
            {
              "type": "random_int",
              "max": 9,
              "stream": "actor"
            }
          ]
        }
      },
      {
        "name": "yielded",
        "value": {
          "type": "expr",
          "op": "min",
          "operands": [
            {
              "type": "target_state",
              "key": "amount"
            },
            {
              "type": "binding",
              "name": "attempt"
            }
          ]
        }
      }
    ],
    "conditions": [
      {
        "left": {
          "type": "target_state",
          "key": "amount"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 0
        }
      }
    ],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "target"
        },
        "stateKey": "amount",
        "operation": "add",
        "valueRef": {
          "type": "expr",
          "op": "neg",
          "operands": [
            {
              "type": "binding",
              "name": "yielded"
            }
          ]
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "actor"
        },
        "stateKey": "carried_food",
        "operation": "add",
        "valueRef": {
          "type": "binding",
          "name": "yielded"
        }
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.dangerous_places_are_rich"
    ]
  },
  {
    "id": "rule.trade_transfer",
    "name": "거래 이전",
    "scope": "relationship",
    "priority": 40,
    "triggers": [
      {
        "type": "action_executed",
        "actionId": "action.trade"
      }
    ],
    "bindings": [
      {
        "name": "amount",
        "value": {
          "type": "expr",
          "op": "min",
          "operands": [
            {
              "type": "actor_state",
              "key": "carried_food"
            },
            {
              "type": "constant",
              "value": 20
            }
          ]
        }
      },
      {
        "name": "price",
        "value": {
          "type": "world_state",
          "key": "food_price"
        }
      }
    ],
    "conditions": [
      {
        "left": {
          "type": "entity_type",
          "of": "target"
        },
        "operator": "==",
        "right": {
          "type": "constant",
          "value": "faction"
        }
      },
      {
        "left": {
          "type": "binding",
          "name": "amount"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 0
        }
      }
    ],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "actor"
        },
        "stateKey": "carried_food",
        "operation": "add",
        "valueRef": {
          "type": "expr",
          "op": "neg",
          "operands": [
            {
              "type": "binding",
              "name": "amount"
            }
          ]
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "target"
        },
        "stateKey": "food_reserve",
        "operation": "add",
        "valueRef": {
          "type": "binding",
          "name": "amount"
        }
      },
      {
        "type": "modify_state",
        "target": {
          "type": "actor"
        },
        "stateKey": "wealth",
        "operation": "add",
        "valueRef": {
          "type": "expr",
          "op": "div",
          "operands": [
            {
              "type": "expr",
              "op": "mul",
              "operands": [
                {
                  "type": "binding",
                  "name": "amount"
                },
                {
                  "type": "binding",
                  "name": "price"
                }
              ]
            },
            {
              "type": "constant",
              "value": 10
            }
          ]
        }
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.scarcity_creates_exchange"
    ]
  }
]