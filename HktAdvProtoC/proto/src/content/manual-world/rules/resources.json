      "trade",
      "trade_goods",
      "overuse"
    ],
    "scope": "global",
    "priority": 55,
    "triggers": [
      {
        "type": "action_executed",
        "actionId": "action.trade"
      }
    ],
    "conditions": [
      {
        "left": {
          "type": "actor_state",
          "key": "carried_goods"
        },
        "operator": ">",
        "right": {
          "type": "constant",
          "value": 80
        }
      }
    ],
    "effects": [
      {
        "type": "modify_state",
        "target": {
          "type": "world"
        },
        "stateKey": "food_price",
        "operation": "add",
        "value": -10
      }
    ],
    "observations": [],
    "derivedFromAxioms": [
      "axiom.scarcity_creates_exchange"
    ]
  }
]