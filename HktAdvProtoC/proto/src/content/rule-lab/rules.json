  {
    "id": "rule.lab_heal",
    "name": "조건 비교 + 상태 변경",
    "scope": "global",
    "priority": 90,
    "triggers": [{ "type": "interval", "interval": 10 }],
    "forEach": {
      "type": "query",
      "query": {
        "entityType": "agent",
        "where": [
          {
            "left": { "type": "each_state", "key": "health" },
            "operator": "<",
            "right": { "type": "constant", "value": 40 }
          }
        ]
      }
    },
    "conditions": [],
    "effects": [
      {
        "type": "modify_state",
        "target": { "type": "target" },
        "stateKey": "health",
        "operation": "add",
        "value": 5
      }
    ],
    "observations": [],
    "derivedFromAxioms": []
  },
