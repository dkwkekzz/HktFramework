{
  "schema": 2,
  "storyTag": "Story.Event.Target.Action",
  "cancelOnDuplicate": true,
  "steps": [
    { "comment": "── I-0016: 우클릭을 ActionIntent 프로퍼티에 기록만 한다. 거리/쿨다운/실행은 Lifecycle Story 의 Brain 루프 책임. Item 분기는 제거 (TODO — Pickup 재정립). ──" },
    { "op": "Log", "message": "TargetAction: 진입 — Self=주체, Target=대상" },

    { "comment": "── Self == Target 차단: 자기 자신 클릭은 무반응 ──" },
    { "op": "CmpEq", "dst": "Flag", "src1": "Self", "src2": "Target" },
    { "op": "JumpIf", "cond": "Flag", "label": "noop" },

    { "comment": "── 이벤트 페이로드 → 로컬 var ──" },
    { "op": "LoadStore", "dst": {"var":"locX"}, "property": "TargetPosX" },
    { "op": "LoadStore", "dst": {"var":"locY"}, "property": "TargetPosY" },
    { "op": "LoadStore", "dst": {"var":"locZ"}, "property": "TargetPosZ" },
    { "op": "LoadStore", "dst": {"var":"slot"}, "property": "Param1" },

    { "comment": "── Target 무효(-1) → Move 인텐트 ──" },
    { "op": "CmpEqConst", "dst": "Flag", "src": "Target", "value": -1 },
    { "op": "JumpIf", "cond": "Flag", "label": "write_move" },

    { "comment": "── Hittable 검사: 통과 시 Attack 인텐트, 아니면 Move ──" },
    { "op": "CheckTrait", "dst": {"var":"isHittable"}, "entity": "Target", "trait": "Hittable" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"isHittable"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "write_move" },

    { "comment": "── Attack 인텐트 기록: Target 보존, 위치도 같이 보관해 brain 이 chase 시 활용 ──" },
    { "op": "Log", "message": "TargetAction: Attack 인텐트 세팅" },
    { "op": "Move", "dst": {"var":"target"}, "src": "Target" },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentTarget", "src": {"var":"target"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentX", "src": {"var":"locX"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentY", "src": {"var":"locY"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentZ", "src": {"var":"locZ"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentSlot", "src": {"var":"slot"} },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentType", "value": 2 },
    { "op": "Halt" },

    { "op": "Label", "name": "write_move" },
    { "op": "Log", "message": "TargetAction: Move 인텐트 세팅" },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentTarget", "value": 0 },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentX", "src": {"var":"locX"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentY", "src": {"var":"locY"} },
    { "op": "SaveStoreEntity", "entity": "Self", "property": "ActionIntentZ", "src": {"var":"locZ"} },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentSlot", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentType", "value": 1 },
    { "op": "Halt" },

    { "op": "Label", "name": "noop" },
    { "op": "Log", "message": "TargetAction: Self == Target — 자기 자신 클릭 무시" },
    { "op": "Halt" }
  ]
}
