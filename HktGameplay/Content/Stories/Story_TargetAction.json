{
  "schema": 2,
  "storyTag": "Story.Event.Target.Action",
  "cancelOnDuplicate": true,
  "tags": {
    "StoryItemPickup":   "Story.Event.Item.Pickup",
    "StoryUseSkill":     "Story.Event.Combat.UseSkill",
    "StoryMoveLocation": "Story.Event.Move.ToLocation"
  },
  "steps": [
    { "op": "Log", "message": "TargetAction: 진입 — Self=주체, Target=대상" },

    { "op": "CmpEqConst", "dst": "Flag", "src": "Target", "value": -1 },
    { "op": "JumpIf", "cond": "Flag", "label": "dispatch_move" },

    { "comment": "── Self == Target 차단: 자기 자신 클릭은 무반응 (자기 공격/Pickup 방지) ──" },
    { "op": "CmpEq", "dst": "Flag", "src1": "Self", "src2": "Target" },
    { "op": "JumpIf", "cond": "Flag", "label": "self_target_noop" },

    { "op": "LoadStoreEntity", "dst": {"var":"itemId"}, "entity": "Target", "property": "ItemId" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"itemId"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "check_hittable" },

    { "op": "LoadStoreEntity", "dst": {"var":"itemState"}, "entity": "Target", "property": "ItemState" },
    { "op": "CmpEqConst", "dst": "Flag", "src": {"var":"itemState"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "dispatch_move" },

    { "op": "Log", "message": "TargetAction: Item → 접근 후 Pickup" },
    { "op": "GetDistance", "dst": {"var":"dist"}, "entity1": "Self", "entity2": "Target" },
    { "op": "CmpLeConst", "dst": "Flag", "src": {"var":"dist"}, "value": 300 },
    { "op": "JumpIf", "cond": "Flag", "label": "item_pickup" },

    { "op": "Label", "name": "item_chase_loop" },
    { "op": "GetPosition", "out": "targetPos", "entity": "Target" },
    { "op": "MoveToward", "entity": "Self", "targetPos": {"block":"targetPos"}, "force": 150 },
    { "op": "Yield", "frames": 1 },
    { "op": "GetDistance", "dst": {"var":"dist"}, "entity1": "Self", "entity2": "Target" },
    { "op": "CmpLeConst", "dst": "Flag", "src": {"var":"dist"}, "value": 300 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "item_chase_loop" },
    { "op": "StopMovement", "entity": "Self" },

    { "op": "Label", "name": "item_pickup" },
    { "op": "DispatchEvent", "eventTag": "StoryItemPickup" },
    { "op": "Halt" },

    { "comment": "── Hittable (Health 보유) — NPC / 자연 entity 공통: 사거리 검증 → 접근 → 쿨다운 → UseSkill ──" },
    { "op": "Label", "name": "check_hittable" },
    { "op": "CheckTrait", "dst": {"var":"isHittable"}, "entity": "Target", "trait": "Hittable" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"isHittable"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "dispatch_move" },

    { "op": "SnippetLoadItemFromSlot", "dst": {"var":"item"}, "failLabel": "use_self_range" },
    { "op": "LoadEntityProperty", "dst": {"var":"range"}, "entity": {"var":"item"}, "property": "AttackRange" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"range"}, "value": 0 },
    { "op": "JumpIf", "cond": "Flag", "label": "range_ok" },

    { "op": "Label", "name": "use_self_range" },
    { "op": "ReadProperty", "dst": {"var":"range"}, "property": "AttackRange" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"range"}, "value": 0 },
    { "op": "JumpIf", "cond": "Flag", "label": "range_ok" },
    { "op": "LoadConst", "dst": {"var":"range"}, "value": 200 },

    { "op": "Label", "name": "range_ok" },
    { "op": "GetDistance", "dst": {"var":"dist"}, "entity1": "Self", "entity2": "Target" },
    { "op": "CmpLe", "dst": "Flag", "src1": {"var":"dist"}, "src2": {"var":"range"} },
    { "op": "JumpIf", "cond": "Flag", "label": "check_cd" },

    { "op": "Label", "name": "chase_loop" },
    { "op": "GetPosition", "out": "targetPos2", "entity": "Target" },
    { "op": "MoveToward", "entity": "Self", "targetPos": {"block":"targetPos2"}, "force": 150 },
    { "op": "Yield", "frames": 1 },
    { "op": "GetDistance", "dst": {"var":"dist"}, "entity1": "Self", "entity2": "Target" },
    { "op": "CmpLe", "dst": "Flag", "src1": {"var":"dist"}, "src2": {"var":"range"} },
    { "op": "JumpIfNot", "cond": "Flag", "label": "chase_loop" },
    { "op": "StopMovement", "entity": "Self" },

    { "op": "Label", "name": "check_cd" },
    { "op": "GetWorldTime", "dst": {"var":"now"} },
    { "op": "ReadProperty", "dst": {"var":"nextFrame"}, "property": "NextActionFrame" },
    { "op": "CmpGe", "dst": "Flag", "src1": {"var":"now"}, "src2": {"var":"nextFrame"} },
    { "op": "JumpIfNot", "cond": "Flag", "label": "done" },

    { "op": "Log", "message": "TargetAction: Hittable → UseSkill" },
    { "op": "DispatchEvent", "eventTag": "StoryUseSkill" },

    { "comment": "── I-0016: Param3==1 (지속 인텐트) 면 쿨다운 대기 후 다음 사이클로 루프. 0 이면 단발 종료. ──" },
    { "op": "ReadProperty", "dst": {"var":"persistent"}, "property": "Param3" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"persistent"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "done" },

    { "comment": "── 쿨다운(NextActionFrame) 경과까지 매 프레임 대기 — BasicAttack/UseSkill 이 디스패치 사이클에서 NextActionFrame 을 갱신 ──" },
    { "op": "Label", "name": "persist_wait_cd" },
    { "op": "Yield", "frames": 1 },
    { "op": "GetWorldTime", "dst": {"var":"now"} },
    { "op": "ReadProperty", "dst": {"var":"nextFrame"}, "property": "NextActionFrame" },
    { "op": "CmpLt", "dst": "Flag", "src1": {"var":"now"}, "src2": {"var":"nextFrame"} },
    { "op": "JumpIf", "cond": "Flag", "label": "persist_wait_cd" },

    { "comment": "── 대상 사망 시 루프 종료 (Health <= 0) ──" },
    { "op": "LoadStoreEntity", "dst": {"var":"hp"}, "entity": "Target", "property": "Health" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"hp"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "done" },

    { "comment": "── 사거리 재검증 후 다음 공격 — chase_loop 가 사거리 이탈을 자동 처리 ──" },
    { "op": "Jump", "label": "range_ok" },

    { "op": "Label", "name": "done" },
    { "op": "Halt" },

    { "op": "Label", "name": "dispatch_move" },
    { "op": "Log", "message": "TargetAction: 이동" },
    { "op": "DispatchEvent", "eventTag": "StoryMoveLocation" },
    { "op": "Halt" },

    { "op": "Label", "name": "self_target_noop" },
    { "op": "Log", "message": "TargetAction: Self == Target — 자기 자신 클릭 무시" },
    { "op": "Halt" }
  ]
}
