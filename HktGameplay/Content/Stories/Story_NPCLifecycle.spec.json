{
  "storyTag": "Story.Flow.NPC.Lifecycle",
  "description": "NPCLifecycle (I-0016): 매-프레임 Brain 루프 (ActionIntent 해석 → 이동/공격) + 죽음 처리 (랜덤 loot drop + DestroyEntity). Brain 본문은 PlayerLifecycle 와 동일 — 차이는 die 분기뿐. 시나리오는 TargetAction 이 ActionIntent* 를 기록한 직후 상태를 given 으로 재현해 한 사이클 결과를 검증한다.",
  "scenarios": [
    {
      "name": "death_path_random_drop_then_destroy",
      "description": "초기에 State.Dead 가 붙은 NPC → 첫 Yield 다음 die 분기 진입. RandomInt 결과는 비결정적이라 status=Completed 만 검증. WaitSeconds 3.0 은 하니스 Timer 가 자동 진행.",
      "given": {
        "self": {
          "properties": { "Health": 0, "MaxHealth": 100 },
          "tags": ["State.Dead"],
          "position": [0, 0, 0]
        }
      },
      "expect": { "status": "Completed" }
    },
    {
      "name": "idle_npc_keeps_looping",
      "description": "ActionIntentType=0 (idle) + Health>0 → brain 은 매 프레임 yield 하며 영구 루프 (현 NPC AI 가 ActionIntent 를 세팅하는 채널이 없어 영원히 idle — I-0016 TODO).",
      "given": {
        "self": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100, "ActionIntentType": 0 },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 5,
      "expect": { "status": "Waiting" }
    },
    {
      "name": "attack_intent_in_range_dispatches_useskill",
      "description": "NPC 에 외부에서 ActionIntentType=2 + Target 을 주입(미래 NPC AI 채널 가정) → dist≤200, 쿨다운 OK → DispatchEventTo(UseSkill, Target). Brain 본문은 Player 와 동일.",
      "given": {
        "self": {
          "archetype": "NPC",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"},
            "NextActionFrame": 0
          },
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "Character",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [100, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 0,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"}
          }
        },
        "dispatched": [
          { "eventTag": "Story.Event.Combat.UseSkill", "source": "self", "target": "target" }
        ]
      }
    },
    {
      "name": "attack_intent_out_of_range_chases_target",
      "description": "ActionIntentType=2 + dist>200 → MoveToward(Target.pos). MoveTargetX/Y/Z 는 Target 좌표로 세팅, MoveForce=150, IsMoving=1.",
      "given": {
        "self": {
          "archetype": "NPC",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"},
            "NextActionFrame": 0
          },
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "Character",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [1000, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 1,
            "MoveTargetX": 1000,
            "MoveTargetY": 0,
            "MoveTargetZ": 0,
            "MoveForce": 150,
            "ActionIntentType": 2
          }
        },
        "dispatched": []
      }
    },
    {
      "name": "move_intent_far_moves_toward",
      "description": "ActionIntentType=1 + ActionIntentX/Y/Z 가 현 위치에서 임계 초과 → MoveToward(ix,iy,iz) (chase 가 아니라 좌표 직접). MoveTarget* 가 ActionIntent* 좌표로 세팅.",
      "given": {
        "self": {
          "archetype": "NPC",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 1,
            "ActionIntentX": 1000, "ActionIntentY": 0, "ActionIntentZ": 0
          },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 1,
            "MoveTargetX": 1000,
            "MoveTargetY": 0,
            "MoveTargetZ": 0,
            "MoveForce": 150,
            "ActionIntentType": 1
          }
        },
        "dispatched": []
      }
    },
    {
      "name": "move_intent_arrived_clears_intent",
      "description": "ActionIntentType=1 인데 squared 2D 거리 ≤ 16 (MovementSystem 의 ArrivalThresholdSq 와 동일) → 도착 분기 → StopMovement + ActionIntentType=0 + ActionIntentTarget=0.",
      "given": {
        "self": {
          "archetype": "NPC",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 1,
            "ActionIntentX": 2, "ActionIntentY": 2, "ActionIntentZ": 0,
            "IsMoving": 1
          },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "ActionIntentType": 0,
            "ActionIntentTarget": 0,
            "IsMoving": 0
          }
        },
        "dispatched": []
      }
    }
  ]
}
