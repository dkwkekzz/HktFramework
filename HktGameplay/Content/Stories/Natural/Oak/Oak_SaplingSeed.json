{
  "schema": 2,
  "storyTag": "Event.Natural.OakSaplingSeed",
  "tags": {
    "Oak":        "Entity.Natural.Oak",
    "OakSapling": "Entity.Natural.OakSapling"
  },
  "steps": [
    { "op": "Log", "message": "[Oak] OakSaplingSeed — spawn 1 OakSapling, carry SpawnerSlotKey (Param2)" },

    { "op": "LoadStore", "dst": {"block":"seedPos","index":0}, "property": "TargetPosX" },
    { "op": "LoadStore", "dst": {"block":"seedPos","index":1}, "property": "TargetPosY" },
    { "op": "LoadStore", "dst": {"block":"seedPos","index":2}, "property": "TargetPosZ" },
    { "op": "LoadStore", "dst": {"var":"slotKey"}, "property": "Param2" },

    { "op": "SpawnEntity", "classTag": "OakSapling", "out": "sapling" },
    { "op": "SetPosition", "entity": {"var":"sapling"}, "pos": {"block":"seedPos"} },
    { "op": "SaveStoreEntity", "entity": {"var":"sapling"}, "property": "SpawnerSlotKey", "src": {"var":"slotKey"} },

    { "op": "Halt" }
  ]
}
