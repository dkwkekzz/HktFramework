{
  "schema": 2,
  "storyTag": "Event.Terrain.ChunkLoaded",
  "tags": {
    "OakSpawn":   "Story.Flow.Spawner.Natural.Oak",
    "BirchSpawn": "Story.Flow.Spawner.Natural.Birch"
  },
  "steps": [
    { "op": "Log", "message": "[Placement.TranquilWilds] ChunkLoaded — biome→spawner dispatch" },

    { "op": "LoadStore", "dst": {"var":"biome"},      "property": "Param2" },
    { "op": "LoadStore", "dst": {"var":"slotHash31"}, "property": "Param3" },

    { "comment": "── Forest (legacy 200+EHktBiomeType::Forest=203) → OakSpawn. Param2 를 lineageId(slotHash31) 로 덮어 dispatch ──" },
    { "op": "IfEqConst", "src": {"var":"biome"}, "value": 203 },
      { "op": "Log", "message": "[Placement] Forest → OakSpawn (lineage=slotHash31)" },
      { "op": "SaveStore", "property": "Param2", "src": {"var":"slotHash31"} },
      { "op": "DispatchEvent", "eventTag": "OakSpawn" },
      { "op": "Halt" },
    { "op": "EndIf" },

    { "comment": "── Grassland (legacy 200+Grassland=200) → BirchSpawn. Birch_Spawn 은 Param0/1 만 사용. ──" },
    { "op": "IfEqConst", "src": {"var":"biome"}, "value": 200 },
      { "op": "Log", "message": "[Placement] Grassland → BirchSpawn" },
      { "op": "DispatchEvent", "eventTag": "BirchSpawn" },
      { "op": "Halt" },
    { "op": "EndIf" },

    { "comment": "── 그 외 biome (Desert/Tundra/Swamp/Mountain/고급 모드 EHktAdvBiome) — 매핑 없음. 후속 PR 에서 룰 추가. ──" },
    { "op": "Log", "message": "[Placement] biome 매핑 없음 — skip" },
    { "op": "Halt" }
  ]
}
