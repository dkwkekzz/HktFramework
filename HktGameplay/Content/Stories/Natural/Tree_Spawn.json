{
  "schema": 2,
  "storyTag": "Story.Flow.Spawner.Natural.Tree",
  "tags": {
    "Oak":          "Entity.Natural.Oak",
    "OakLifecycle": "Story.Flow.Natural.Oak.Lifecycle"
  },
  "steps": [
    { "op": "Log", "message": "[Tree] voxel attribution — Oak 1본 spawn + Oak_Lifecycle dispatch" },

    { "op": "LoadStore", "dst": {"var":"posX"},      "property": "Param0" },
    { "op": "LoadStore", "dst": {"var":"posY"},      "property": "Param1" },
    { "op": "LoadStore", "dst": {"var":"lineageId"}, "property": "Param2" },
    { "op": "LoadStore", "dst": {"var":"posZ"},      "property": "Param3" },

    { "op": "SpawnEntity", "classTag": "Oak", "out": "oak" },

    { "op": "Move", "dst": {"block":"pos","index":0}, "src": {"var":"posX"} },
    { "op": "Move", "dst": {"block":"pos","index":1}, "src": {"var":"posY"} },
    { "op": "Move", "dst": {"block":"pos","index":2}, "src": {"var":"posZ"} },
    { "op": "SetPosition", "entity": {"var":"oak"}, "pos": {"block":"pos"} },

    { "op": "SaveStoreEntity", "entity": {"var":"oak"}, "property": "RecordKey", "src": {"var":"lineageId"} },
    { "op": "SaveConstEntity", "entity": {"var":"oak"}, "property": "MaxHealth", "value": 40 },
    { "op": "SaveConstEntity", "entity": {"var":"oak"}, "property": "Health",    "value": 40 },

    { "op": "DispatchEventFrom", "eventTag": "OakLifecycle", "source": {"var":"oak"} },

    { "op": "Halt" }
  ]
}
