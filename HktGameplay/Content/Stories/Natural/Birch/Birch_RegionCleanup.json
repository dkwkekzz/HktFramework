{
  "schema": 2,
  "storyTag": "Story.Flow.Natural.Birch.RegionCleanup",
  "tags": {
    "VoxelSlot":    "Entity.RegionRecord.VoxelSlot",
    "StateDead":    "State.Dead",
    "BirchSpawner": "Story.Flow.Spawner.Natural.Birch"
  },
  "steps": [
    { "op": "Log", "message": "[Birch] RegionCleanup 시작 — Self=Birch, State.Dead 감지 후 slot release + cooldown wait + spawner 재dispatch" },

    { "op": "Label", "name": "check" },
    { "op": "HasTag", "dst": {"var":"isDead"}, "entity": "Self", "tag": "StateDead" },
    { "op": "JumpIf", "cond": {"var":"isDead"}, "label": "die" },
    { "op": "Yield", "frames": 1 },
    { "op": "Jump", "label": "check" },

    { "op": "Label", "name": "die" },
    { "op": "Log", "message": "[Birch] 사망 감지 — slot release 후 90초 cooldown 시작" },

    { "op": "GetPosition", "out": "fallenPos", "entity": "Self" },
    { "op": "FindOrCreateRegionAt",
      "posX": {"block":"fallenPos","index":0},
      "posY": {"block":"fallenPos","index":1},
      "out": "regionEntity" },
    { "op": "LoadStoreEntity", "dst": {"var":"slotKey"}, "entity": "Self", "property": "RecordKey" },
    { "op": "GetWorldTime", "dst": {"var":"now"} },
    { "op": "LoadConst", "dst": {"var":"zero"}, "value": 0 },
    { "op": "RegionMapWrite",
      "regionEntity": {"var":"regionEntity"}, "recordTag": "VoxelSlot",
      "key": {"var":"slotKey"}, "property": "SlotAliveFlag", "value": {"var":"zero"} },
    { "op": "RegionMapWrite",
      "regionEntity": {"var":"regionEntity"}, "recordTag": "VoxelSlot",
      "key": {"var":"slotKey"}, "property": "SlotLastDieFrame", "value": {"var":"now"} },

    { "op": "WaitSeconds", "seconds": 90.0 },

    { "op": "Log", "message": "[Birch] cooldown 만료 — Birch spawner 재dispatch (player 청크 reload 와 무관하게 시간 기반 재spawn)" },
    { "op": "SaveStore", "property": "Param0", "src": {"block":"fallenPos","index":0} },
    { "op": "SaveStore", "property": "Param1", "src": {"block":"fallenPos","index":1} },
    { "op": "SaveStore", "property": "Param2", "src": {"var":"slotKey"} },
    { "op": "SaveStore", "property": "Param3", "src": {"block":"fallenPos","index":2} },
    { "op": "DispatchEventFrom", "eventTag": "BirchSpawner", "source": {"var":"regionEntity"} },

    { "op": "Halt" }
  ]
}
