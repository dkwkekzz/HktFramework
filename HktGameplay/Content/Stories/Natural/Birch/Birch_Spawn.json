{
  "schema": 2,
  "storyTag": "Story.Flow.Spawner.Natural.Birch",
  "tags": {
    "Birch": "Entity.Natural.Birch"
  },
  "steps": [
    { "op": "Log", "message": "[Birch] chunk-load spawner — emit 3 birches around (Param0, Param1, Param3=Z)" },

    { "op": "CountByTag", "dst": {"var":"birchCount"}, "tag": "Birch" },
    { "op": "IfGeConst", "src": {"var":"birchCount"}, "value": 12 },
      { "op": "Log", "message": "[Birch] global cap reached (12) — skip" },
      { "op": "Halt" },
    { "op": "EndIf" },


    { "op": "LoadStore", "dst": {"var":"baseX"}, "property": "Param0" },
    { "op": "LoadStore", "dst": {"var":"baseY"}, "property": "Param1" },
    { "op": "LoadStore", "dst": {"var":"posZ"},  "property": "Param3" },

    { "op": "LoadConst", "dst": {"var":"ox1"}, "value": 200 },
    { "op": "LoadConst", "dst": {"var":"oy1"}, "value": 0 },
    { "op": "SpawnEntity", "classTag": "Entity.Natural.Birch", "out": "b1" },
    { "op": "Add", "dst": {"block":"pos1","index":0}, "src1": {"var":"baseX"}, "src2": {"var":"ox1"} },
    { "op": "Add", "dst": {"block":"pos1","index":1}, "src1": {"var":"baseY"}, "src2": {"var":"oy1"} },
    { "op": "Move", "dst": {"block":"pos1","index":2}, "src": {"var":"posZ"} },
    { "op": "SetPosition", "entity": {"var":"b1"}, "pos": {"block":"pos1"} },

    { "op": "LoadConst", "dst": {"var":"ox2"}, "value": -100 },
    { "op": "LoadConst", "dst": {"var":"oy2"}, "value": 173 },
    { "op": "SpawnEntity", "classTag": "Entity.Natural.Birch", "out": "b2" },
    { "op": "Add", "dst": {"block":"pos2","index":0}, "src1": {"var":"baseX"}, "src2": {"var":"ox2"} },
    { "op": "Add", "dst": {"block":"pos2","index":1}, "src1": {"var":"baseY"}, "src2": {"var":"oy2"} },
    { "op": "Move", "dst": {"block":"pos2","index":2}, "src": {"var":"posZ"} },
    { "op": "SetPosition", "entity": {"var":"b2"}, "pos": {"block":"pos2"} },

    { "op": "LoadConst", "dst": {"var":"ox3"}, "value": -100 },
    { "op": "LoadConst", "dst": {"var":"oy3"}, "value": -173 },
    { "op": "SpawnEntity", "classTag": "Entity.Natural.Birch", "out": "b3" },
    { "op": "Add", "dst": {"block":"pos3","index":0}, "src1": {"var":"baseX"}, "src2": {"var":"ox3"} },
    { "op": "Add", "dst": {"block":"pos3","index":1}, "src1": {"var":"baseY"}, "src2": {"var":"oy3"} },
    { "op": "Move", "dst": {"block":"pos3","index":2}, "src": {"var":"posZ"} },
    { "op": "SetPosition", "entity": {"var":"b3"}, "pos": {"block":"pos3"} },

    { "op": "Halt" }
  ]
}
