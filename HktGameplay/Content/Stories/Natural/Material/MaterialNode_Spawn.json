{
  "schema": 2,
  "storyTag": "Story.Flow.Spawner.Natural.MaterialNode",
  "tags": {
    "ItemWood":     "Entity.Item.Wood",
    "TagMaterial":  "Entity.Attr.Item.Material"
  },
  "steps": [
    { "op": "Log", "message": "[MaterialNode] voxel attribution 발화 — Wood 1개 drop at voxel center" },

    { "op": "LoadStore", "dst": {"var":"posX"}, "property": "Param0" },
    { "op": "LoadStore", "dst": {"var":"posY"}, "property": "Param1" },
    { "op": "LoadStore", "dst": {"var":"posZ"}, "property": "Param3" },

    { "op": "SpawnEntity", "classTag": "ItemWood", "out": "wood" },
    { "op": "AddTag", "entity": {"var":"wood"}, "tag": "TagMaterial" },

    { "op": "SaveConstEntity", "entity": {"var":"wood"}, "property": "ItemState",   "value": 0 },
    { "op": "SaveConstEntity", "entity": {"var":"wood"}, "property": "ItemId",      "value": 101 },
    { "op": "SaveConstEntity", "entity": {"var":"wood"}, "property": "EquipIndex",  "value": -1 },

    { "op": "Move", "dst": {"block":"pos","index":0}, "src": {"var":"posX"} },
    { "op": "Move", "dst": {"block":"pos","index":1}, "src": {"var":"posY"} },
    { "op": "Move", "dst": {"block":"pos","index":2}, "src": {"var":"posZ"} },
    { "op": "SetPosition", "entity": {"var":"wood"}, "pos": {"block":"pos"} },

    { "op": "Halt" }
  ]
}
