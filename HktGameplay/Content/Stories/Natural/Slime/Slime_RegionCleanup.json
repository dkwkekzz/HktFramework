{
  "schema": 2,
  "storyTag": "Story.Flow.Natural.Slime.RegionCleanup",
  "tags": {
    "VoxelSlot": "Entity.RegionRecord.VoxelSlot",
    "StateDead": "State.Dead"
  },
  "steps": [
    { "op": "Log", "message": "[Slime] RegionCleanup 시작 — Self=Slime entity, State.Dead 감지 후 VoxelSlot 해제" },

    { "op": "Label", "name": "check" },
    { "op": "HasTag", "dst": {"var":"isDead"}, "entity": "Self", "tag": "StateDead" },
    { "op": "JumpIf", "cond": {"var":"isDead"}, "label": "die" },
    { "op": "Yield", "frames": 1 },
    { "op": "Jump", "label": "check" },

    { "op": "Label", "name": "die" },
    { "op": "Log", "message": "[Slime] 사망 감지 — VoxelSlot 해제 + LastDieFrame 기록" },

    { "op": "GetPosition", "out": "fallenPos", "entity": "Self" },
    { "op": "FindOrCreateRegionAt",
      "posX": {"block":"fallenPos","index":0},
      "posY": {"block":"fallenPos","index":1},
      "out": "regionEntity" },
    { "op": "LoadStoreEntity", "dst": {"var":"slotKey"}, "entity": "Self", "property": "RecordKey" },
    { "op": "GetWorldTime", "dst": {"var":"now"} },
    { "op": "LoadConst", "dst": {"var":"zero"}, "value": 0 },
    { "op": "RegionMapWrite",
      "regionEntity": {"var":"regionEntity"}, "recordTag": "VoxelSlot",
      "key": {"var":"slotKey"}, "property": "SlotAliveFlag", "value": {"var":"zero"} },
    { "op": "RegionMapWrite",
      "regionEntity": {"var":"regionEntity"}, "recordTag": "VoxelSlot",
      "key": {"var":"slotKey"}, "property": "SlotLastDieFrame", "value": {"var":"now"} },

    { "op": "Halt" }
  ]
}
