{
  "schema": 2,
  "storyTag": "Story.Flow.Spawner.Natural.Slime",
  "tags": {
    "NpcSlime":      "Entity.NPC.Slime",
    "EntityNPC":     "Entity.NPC",
    "NpcHostile":    "Entity.Attr.NPC.Hostile",
    "StanceUnarmed": "Entity.Stance.Unarmed",
    "NpcLifecycle":  "Story.Flow.NPC.Lifecycle",
    "SlimeBrain":    "Story.Flow.Brain.Slime",
    "StateDead":     "State.Dead"
  },
  "steps": [
    { "op": "Log", "message": "[Slime] spawner-as-loop 시작 — 한 voxel-slot 의 영구 sentinel" },

    { "op": "LoadStore", "dst": {"block":"spawnPos","index":0}, "property": "Param0" },
    { "op": "LoadStore", "dst": {"block":"spawnPos","index":1}, "property": "Param1" },
    { "op": "LoadStore", "dst": {"var":"slotKey"},              "property": "Param2" },
    { "op": "LoadStore", "dst": {"block":"spawnPos","index":2}, "property": "Param3" },

    { "op": "SpawnerFindOrCreate", "slotKey": {"var":"slotKey"}, "out": "spawnerEntity" },

    { "op": "Label", "name": "top" },

    { "op": "LoadStoreEntity", "dst": {"var":"alive"}, "entity": {"var":"spawnerEntity"}, "property": "SpawnerAliveFlag" },
    { "op": "IfGeConst", "src": {"var":"alive"}, "value": 1 },
      { "op": "Log", "message": "[Slime] slot 점유 중 (다른 instance 가 spawn) — Halt 로 양보" },
      { "op": "Halt" },
    { "op": "EndIf" },

    { "op": "LoadStoreEntity", "dst": {"var":"lastDie"}, "entity": {"var":"spawnerEntity"}, "property": "SpawnerLastDeathFrame" },
    { "op": "IfGeConst", "src": {"var":"lastDie"}, "value": 1 },
      { "op": "GetWorldTime", "dst": {"var":"now"} },
      { "op": "Sub", "dst": {"var":"elapsed"}, "src1": {"var":"now"}, "src2": {"var":"lastDie"} },
      { "op": "IfLtConst", "src": {"var":"elapsed"}, "value": 900 },
        { "op": "Log", "message": "[Slime] cooldown 진행 중 — WaitSeconds 30.0 후 respawn" },
        { "op": "WaitSeconds", "seconds": 30.0 },
      { "op": "EndIf" },
    { "op": "EndIf" },

    { "op": "SpawnEntity", "classTag": "NpcSlime", "out": "slime" },

    { "op": "AddTag", "entity": {"var":"slime"}, "tag": "EntityNPC" },
    { "op": "AddTag", "entity": {"var":"slime"}, "tag": "NpcSlime" },
    { "op": "AddTag", "entity": {"var":"slime"}, "tag": "NpcHostile" },

    { "op": "SaveStoreEntity", "entity": {"var":"slime"}, "property": "SpawnerSlotKey", "src":   {"var":"slotKey"} },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "IsNPC",       "value": 1 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "Health",      "value": 30 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "MaxHealth",   "value": 30 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "AttackPower", "value": 8 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "Defense",     "value": 1 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "Team",        "value": 0 },
    { "op": "SaveConstEntity", "entity": {"var":"slime"}, "property": "MaxSpeed",    "value": 60 },

    { "op": "SetStance",   "entity": {"var":"slime"}, "stanceTag": "StanceUnarmed" },
    { "op": "SetPosition", "entity": {"var":"slime"}, "pos": {"block":"spawnPos"} },

    { "op": "LoadConst", "dst": {"var":"one"}, "value": 1 },
    { "op": "SaveStoreEntity", "entity": {"var":"spawnerEntity"}, "property": "SpawnerAliveFlag", "src": {"var":"one"} },

    { "op": "DispatchEventFrom", "eventTag": "NpcLifecycle", "source": {"var":"slime"} },
    { "op": "DispatchEventFrom", "eventTag": "SlimeBrain",   "source": {"var":"slime"} },

    { "op": "Label", "name": "check" },
    { "op": "HasTag", "dst": {"var":"isDead"}, "entity": {"var":"slime"}, "tag": "StateDead" },
    { "op": "JumpIf", "cond": {"var":"isDead"}, "label": "die" },
    { "op": "Yield", "frames": 1 },
    { "op": "Jump", "label": "check" },

    { "op": "Label", "name": "die" },
    { "op": "Log", "message": "[Slime] 사망 감지 — slot release 후 top 으로 jump (cooldown wait + respawn)" },
    { "op": "GetWorldTime", "dst": {"var":"dieTime"} },
    { "op": "LoadConst", "dst": {"var":"zero"}, "value": 0 },
    { "op": "SaveStoreEntity", "entity": {"var":"spawnerEntity"}, "property": "SpawnerAliveFlag",      "src": {"var":"zero"} },
    { "op": "SaveStoreEntity", "entity": {"var":"spawnerEntity"}, "property": "SpawnerLastDeathFrame", "src": {"var":"dieTime"} },
    { "op": "LoadStoreEntity", "dst": {"var":"deathCount"}, "entity": {"var":"spawnerEntity"}, "property": "SpawnerDeathCount" },
    { "op": "AddImm", "dst": {"var":"deathCount"}, "src": {"var":"deathCount"}, "imm": 1 },
    { "op": "SaveStoreEntity", "entity": {"var":"spawnerEntity"}, "property": "SpawnerDeathCount", "src": {"var":"deathCount"} },
    { "op": "Jump", "label": "top" }
  ]
}
