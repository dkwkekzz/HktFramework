{
  "storyTag": "Story.Event.Target.Action",
  "description": "TargetAction (I-0016) — 우클릭을 Self 의 ActionIntent* 프로퍼티에 기록만 한다. 실제 이동/공격은 Lifecycle Brain 이 수행. Item 분기 제거 (TODO).",
  "scenarios": [
    {
      "name": "invalid_target_writes_move_intent",
      "description": "Target = -1 → ActionIntentType=1 (Move) + 좌표 기록.",
      "given": {
        "self":   { "position": [0, 0, 0] },
        "event":  { "targetPosX": 500, "targetPosY": 100, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   1,
            "ActionIntentTarget": 0,
            "ActionIntentX":      500,
            "ActionIntentY":      100,
            "ActionIntentZ":      0
          }
        }
      }
    },
    {
      "name": "hittable_target_writes_attack_intent",
      "description": "Hittable 대상 → ActionIntentType=2 (Attack) + Target 보존.",
      "given": {
        "self":   {
          "archetype": "Character",
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [500, 0, 0]
        }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   2,
            "ActionIntentTarget": {"ref":"target"}
          }
        }
      }
    },
    {
      "name": "non_hittable_target_writes_move_intent",
      "description": "Hittable 아닌 대상 (Projectile 등) → Move 인텐트로 폴백.",
      "given": {
        "self":   { "archetype": "Character", "position": [0, 0, 0] },
        "target": { "archetype": "Projectile", "position": [100, 0, 0] },
        "event":  { "targetPosX": 100, "targetPosY": 0, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   1,
            "ActionIntentTarget": 0,
            "ActionIntentX":      100
          }
        }
      }
    }
  ]
}
