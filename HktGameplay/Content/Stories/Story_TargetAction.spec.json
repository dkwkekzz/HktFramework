{
  "storyTag": "Story.Event.Target.Action",
  "description": "TargetAction (I-0016) — 우클릭을 Self 의 ActionIntent* 프로퍼티에 기록만 한다. 실제 이동/공격은 Lifecycle Brain 이 수행. Item 분기 제거 (TODO). 시나리오는 4 개 분기 (Target=-1 Move / Hittable Attack / Hittable + Slot / Non-Hittable Move) 와 ActionIntent* 6 프로퍼티(Type/Target/X/Y/Z/Slot) 의 정확 일치를 모두 검증한다. Self==Target noop 분기는 spec 러너 한계로 미검증 (Self/Target 이 별개 엔티티로 할당).",
  "scenarios": [
    {
      "name": "invalid_target_writes_move_intent",
      "description": "Target = -1 (빈 곳 클릭) → ActionIntentType=1 (Move) + 좌표 기록, Target=0, Slot=0. 모든 ActionIntent* 6 개를 정확 검증.",
      "given": {
        "self":   { "position": [0, 0, 0] },
        "event":  { "targetPosX": 500, "targetPosY": 100, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   1,
            "ActionIntentTarget": 0,
            "ActionIntentX":      500,
            "ActionIntentY":      100,
            "ActionIntentZ":      0,
            "ActionIntentSlot":   0
          }
        }
      }
    },
    {
      "name": "hittable_target_writes_attack_intent",
      "description": "Hittable 대상 + slot=0 (기본) → ActionIntentType=2 (Attack) + Target 보존 + 위치 보관 (brain 이 chase 시 활용). 6 프로퍼티 모두 검증.",
      "given": {
        "self":   {
          "archetype": "Character",
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [500, 0, 0]
        },
        "event":  { "targetPosX": 500, "targetPosY": 0, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   2,
            "ActionIntentTarget": {"ref":"target"},
            "ActionIntentX":      500,
            "ActionIntentY":      0,
            "ActionIntentZ":      0,
            "ActionIntentSlot":   0
          }
        }
      }
    },
    {
      "name": "hittable_target_with_slot_passes_slot_through",
      "description": "Hittable 대상 + event.param1 (= slot) = 3 → ActionIntentSlot=3 으로 전달. Brain 이 slot 별 스킬을 라우팅할 때 사용.",
      "given": {
        "self":   {
          "archetype": "Character",
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [300, 200, 0]
        },
        "event":  { "param1": 3, "targetPosX": 300, "targetPosY": 200, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   2,
            "ActionIntentTarget": {"ref":"target"},
            "ActionIntentX":      300,
            "ActionIntentY":      200,
            "ActionIntentZ":      0,
            "ActionIntentSlot":   3
          }
        }
      }
    },
    {
      "name": "non_hittable_target_writes_move_intent",
      "description": "Hittable 아닌 대상 (Projectile 등) → Move 인텐트로 폴백. 6 프로퍼티 검증.",
      "given": {
        "self":   { "archetype": "Character", "position": [0, 0, 0] },
        "target": { "archetype": "Projectile", "position": [100, 0, 0] },
        "event":  { "targetPosX": 100, "targetPosY": 0, "targetPosZ": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "ActionIntentType":   1,
            "ActionIntentTarget": 0,
            "ActionIntentX":      100,
            "ActionIntentY":      0,
            "ActionIntentZ":      0,
            "ActionIntentSlot":   0
          }
        }
      }
    }
  ]
}
