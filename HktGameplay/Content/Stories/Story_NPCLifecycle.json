{
  "schema": 2,
  "storyTag": "Story.Flow.NPC.Lifecycle",
  "cancelOnDuplicate": false,
  "tags": {
    "StateDead":   "State.Dead",
    "AnimDeath":   "Anim.FullBody.Action.Death",
    "UseSkillTag": "Story.Event.Combat.UseSkill"
  },
  "steps": [
    { "comment": "── I-0016: NPC Lifecycle = Brain 루프 + 죽음 처리. 매 프레임 ActionIntent 를 해석해 이동/공격을 결정한다. ──" },

    { "op": "Label", "name": "loop" },
    { "op": "Yield", "frames": 1 },

    { "comment": "── 죽음 감지 ──" },
    { "op": "HasTag", "dst": {"var":"isDead"}, "entity": "Self", "tag": "State.Dead" },
    { "op": "JumpIf", "cond": {"var":"isDead"}, "label": "die" },

    { "comment": "── 인텐트 분기 ──" },
    { "op": "LoadStoreEntity", "dst": {"var":"intentType"}, "entity": "Self", "property": "ActionIntentType" },
    { "op": "CmpEqConst", "dst": "Flag", "src": {"var":"intentType"}, "value": 2 },
    { "op": "JumpIf", "cond": "Flag", "label": "do_attack" },
    { "op": "CmpEqConst", "dst": "Flag", "src": {"var":"intentType"}, "value": 1 },
    { "op": "JumpIf", "cond": "Flag", "label": "do_move" },
    { "op": "Jump", "label": "loop" },

    { "comment": "── Attack 분기: target 유효성/Health → 사거리 → 쿨다운 → 디스패치 ──" },
    { "op": "Label", "name": "do_attack" },
    { "op": "LoadStoreEntity", "dst": {"var":"intentTarget"}, "entity": "Self", "property": "ActionIntentTarget" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"intentTarget"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "clear_intent" },

    { "op": "Move", "dst": "Target", "src": {"var":"intentTarget"} },
    { "op": "LoadStoreEntity", "dst": {"var":"hp"}, "entity": "Target", "property": "Health" },
    { "op": "CmpGtConst", "dst": "Flag", "src": {"var":"hp"}, "value": 0 },
    { "op": "JumpIfNot", "cond": "Flag", "label": "clear_intent" },

    { "op": "GetDistance", "dst": {"var":"dist"}, "entity1": "Self", "entity2": "Target" },
    { "op": "LoadConst", "dst": {"var":"range"}, "value": 200 },
    { "op": "CmpLe", "dst": "Flag", "src1": {"var":"dist"}, "src2": {"var":"range"} },
    { "op": "JumpIfNot", "cond": "Flag", "label": "chase_target" },

    { "op": "StopMovement", "entity": "Self" },
    { "op": "GetWorldTime", "dst": {"var":"now"} },
    { "op": "ReadProperty", "dst": {"var":"nextFrame"}, "property": "NextActionFrame" },
    { "op": "CmpLt", "dst": "Flag", "src1": {"var":"now"}, "src2": {"var":"nextFrame"} },
    { "op": "JumpIf", "cond": "Flag", "label": "loop" },

    { "op": "LoadStoreEntity", "dst": {"var":"slot"}, "entity": "Self", "property": "ActionIntentSlot" },
    { "op": "Log", "message": "Brain(NPC): Attack 발사 → UseSkill" },
    { "op": "DispatchEventTo", "eventTag": "UseSkillTag", "target": "Target" },
    { "op": "Jump", "label": "loop" },

    { "op": "Label", "name": "chase_target" },
    { "op": "GetPosition", "out": "chasePos", "entity": "Target" },
    { "op": "MoveToward", "entity": "Self", "targetPos": {"block":"chasePos"}, "force": 150 },
    { "op": "Jump", "label": "loop" },

    { "comment": "── Move: ActionIntentX/Y/Z 로 이동. 도착 판정은 squared 2D 거리 vs 임계² (200² = 40000). MoveToward 가 매 호출마다 IsMoving=1 을 재기록하므로 IsMoving 으로는 도착 감지 불가. ──" },
    { "op": "Label", "name": "do_move" },
    { "op": "LoadStoreEntity", "dst": {"var":"ix"}, "entity": "Self", "property": "ActionIntentX" },
    { "op": "LoadStoreEntity", "dst": {"var":"iy"}, "entity": "Self", "property": "ActionIntentY" },
    { "op": "ReadProperty", "dst": {"var":"px"}, "property": "PosX" },
    { "op": "ReadProperty", "dst": {"var":"py"}, "property": "PosY" },
    { "op": "Sub", "dst": {"var":"dx"}, "src1": {"var":"ix"}, "src2": {"var":"px"} },
    { "op": "Sub", "dst": {"var":"dy"}, "src1": {"var":"iy"}, "src2": {"var":"py"} },
    { "op": "Mul", "dst": {"var":"dx2"}, "src1": {"var":"dx"}, "src2": {"var":"dx"} },
    { "op": "Mul", "dst": {"var":"dy2"}, "src1": {"var":"dy"}, "src2": {"var":"dy"} },
    { "op": "Add", "dst": {"var":"d2"}, "src1": {"var":"dx2"}, "src2": {"var":"dy2"} },
    { "op": "CmpLeConst", "dst": "Flag", "src": {"var":"d2"}, "value": 40000 },
    { "op": "JumpIf", "cond": "Flag", "label": "clear_intent" },

    { "op": "LoadStoreEntity", "dst": {"block":"movePos","index":0}, "entity": "Self", "property": "ActionIntentX" },
    { "op": "LoadStoreEntity", "dst": {"block":"movePos","index":1}, "entity": "Self", "property": "ActionIntentY" },
    { "op": "LoadStoreEntity", "dst": {"block":"movePos","index":2}, "entity": "Self", "property": "ActionIntentZ" },
    { "op": "MoveToward", "entity": "Self", "targetPos": {"block":"movePos"}, "force": 150 },
    { "op": "Jump", "label": "loop" },

    { "op": "Label", "name": "clear_intent" },
    { "op": "StopMovement", "entity": "Self" },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentType", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Self", "property": "ActionIntentTarget", "value": 0 },
    { "op": "Jump", "label": "loop" },

    { "comment": "── 죽음 처리: 랜덤 loot drop + 사망 애니 + 파괴 ──" },
    { "op": "Label", "name": "die" },
    { "op": "Log", "message": "NPC died -- random loot drop" },

    { "op": "LoadConst", "dst": {"var":"modulus"}, "value": 4 },
    { "op": "RandomInt", "dst": {"var":"rand"}, "modulus": {"var":"modulus"} },

    { "op": "IfEqConst", "src": {"var":"rand"}, "value": 0 },
      { "op": "Jump", "label": "drop_staff" },
    { "op": "EndIf" },

    { "op": "IfEqConst", "src": {"var":"rand"}, "value": 1 },
      { "op": "Jump", "label": "drop_bandage" },
    { "op": "EndIf" },

    { "op": "IfEqConst", "src": {"var":"rand"}, "value": 2 },
      { "op": "Jump", "label": "drop_hammer" },
    { "op": "EndIf" },

    { "op": "Jump", "label": "drop_wings" },

    { "op": "Label", "name": "drop_staff" },
    { "op": "Log", "message": "[Snippet] SpawnGroundItem" },
    { "op": "SpawnEntity", "classTag": "Entity.Item.AncientStaff" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemState", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemId", "value": 200 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "EquipIndex", "value": -1 },
    { "op": "CopyPosition", "dst": "Spawned", "src": "Self" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "AttackPower", "value": 8 },
    { "op": "SetItemSkillTag", "entity": "Spawned", "skillTag": "Story.Event.Combat.UseSkill" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillCPCost", "value": 50 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "RecoveryFrame", "value": 90 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillTargetRequired", "value": 1 },
    { "op": "SetStance", "entity": "Spawned", "stanceTag": "Entity.Stance.Spear" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Item.AncientStaff" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Skill.Fireball" },
    { "op": "Jump", "label": "after_drop" },

    { "op": "Label", "name": "drop_bandage" },
    { "op": "Log", "message": "[Snippet] SpawnGroundItem" },
    { "op": "SpawnEntity", "classTag": "Entity.Item.Bandage" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemState", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemId", "value": 202 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "EquipIndex", "value": -1 },
    { "op": "CopyPosition", "dst": "Spawned", "src": "Self" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "AttackPower", "value": 0 },
    { "op": "SetItemSkillTag", "entity": "Spawned", "skillTag": "Story.Event.Combat.UseSkill" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillCPCost", "value": 40 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "RecoveryFrame", "value": 120 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillTargetRequired", "value": 0 },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Item.Bandage" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Skill.Heal" },
    { "op": "Jump", "label": "after_drop" },

    { "op": "Label", "name": "drop_hammer" },
    { "op": "Log", "message": "[Snippet] SpawnGroundItem" },
    { "op": "SpawnEntity", "classTag": "Entity.Item.ThunderHammer" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemState", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemId", "value": 203 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "EquipIndex", "value": -1 },
    { "op": "CopyPosition", "dst": "Spawned", "src": "Self" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "AttackPower", "value": 12 },
    { "op": "SetItemSkillTag", "entity": "Spawned", "skillTag": "Story.Event.Combat.UseSkill" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillCPCost", "value": 60 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "RecoveryFrame", "value": 100 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillTargetRequired", "value": 1 },
    { "op": "SetStance", "entity": "Spawned", "stanceTag": "Entity.Stance.Sword1H" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Item.ThunderHammer" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Skill.Lightning" },
    { "op": "Jump", "label": "after_drop" },

    { "op": "Label", "name": "drop_wings" },
    { "op": "Log", "message": "[Snippet] SpawnGroundItem" },
    { "op": "SpawnEntity", "classTag": "Entity.Item.WingsOfFreedom" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemState", "value": 0 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "ItemId", "value": 204 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "EquipIndex", "value": -1 },
    { "op": "CopyPosition", "dst": "Spawned", "src": "Self" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "AttackPower", "value": 0 },
    { "op": "SetItemSkillTag", "entity": "Spawned", "skillTag": "Story.Event.Combat.UseSkill" },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillCPCost", "value": 30 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "RecoveryFrame", "value": 150 },
    { "op": "SaveConstEntity", "entity": "Spawned", "property": "SkillTargetRequired", "value": 0 },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Item.WingsOfFreedom" },
    { "op": "AddTag", "entity": "Spawned", "tag": "Entity.Attr.Skill.Buff" },

    { "op": "Label", "name": "after_drop" },
    { "op": "AddTag", "entity": "Self", "tag": "Anim.FullBody.Action.Death" },
    { "op": "WaitSeconds", "seconds": 3.0 },
    { "op": "DestroyEntity", "entity": "Self" },
    { "op": "Halt" }
  ]
}
