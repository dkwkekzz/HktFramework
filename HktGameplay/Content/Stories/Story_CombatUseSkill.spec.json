{
  "storyTag": "Story.Event.Combat.UseSkill",
  "description": "UseSkill 본문: precondition (쿨타임) 통과 후 SnippetLoadItemFromSlot → CP 차감 → HasTag 분기 (Fireball/Heal/Lightning/Buff) 또는 innate. spec runner 가 precondition 미실행 → 본문이 SnippetCooldownCheck 로 자체 가드. DispatchEvent 는 PendingDispatchedEvents 큐잉만 → 현재 Story 즉시 Halt.",
  "scenarios": [
    {
      "name": "innate_dispatch_when_no_item_in_slot",
      "description": "Param1=0(슬롯) 슬롯 미설정. SnippetLoadItemFromSlot 가 innate label 로 점프. DispatchEvent BasicAttack + Halt → Completed. NextActionFrame 0x7FFFFFFF 잠금 검증.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": { "AttackPower": 10, "AttackSpeed": 100, "NextActionFrame": 0, "MaxCP": 100, "CP": 50 }
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 200 }
        }
      },
      "expect": {
        "status": "Completed",
        "self": { "properties": { "NextActionFrame": 2147483647 } },
        "dispatched": [
          { "eventTag": "Story.Event.Attack.Basic", "source": "self", "target": "target" }
        ]
      }
    },
    {
      "name": "dispatch_fireball_when_item_has_fireball_tag",
      "description": "Self.EquipSlot0 = entities[0] (Fireball 스킬 아이템). CP 충분 → Sub + WriteProperty CP, HasTag Fireball 매치 → DispatchEvent(Fireball) + Halt.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "AttackPower": 10, "AttackSpeed": 100, "NextActionFrame": 0,
            "MaxCP": 100, "CP": 50,
            "EquipSlot0": {"ref": "entities[0]"}
          }
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 200 }
        },
        "entities": [
          {
            "archetype": "Item",
            "properties": { "ItemState": 2, "SkillCPCost": 10, "OwnerEntity": {"ref": "self"} },
            "tags": ["Entity.Item", "Entity.Attr.Skill.Fireball"]
          }
        ],
        "event": { "param1": 0 }
      },
      "expect": {
        "status": "Completed",
        "self": {
          "properties": {
            "CP": 40,
            "NextActionFrame": 2147483647
          }
        },
        "dispatched": [
          { "eventTag": "Story.Event.Skill.Fireball", "source": "self", "target": "target" }
        ]
      }
    },
    {
