{
  "storyTag": "Story.Flow.Player.Lifecycle",
  "description": "PlayerLifecycle (I-0016): 매-프레임 Brain 루프. ActionIntent 를 해석해 이동/공격을 결정. State.Dead 가 붙으면 die 분기 진입 (Player 는 destroy 안 함). 시나리오들은 TargetAction 이 ActionIntent* 를 기록한 직후 상태를 given 으로 재현해 Brain 의 한 사이클 결과(StopMovement/MoveToward/DispatchEventTo/clear)를 검증한다 — 이로써 TargetAction → ActionIntent → Brain 전 구간이 spec 사이로 연결된다.",
  "scenarios": [
    {
      "name": "dead_player_halts_with_death_anim",
      "description": "초기에 State.Dead 가 붙은 Player → 첫 Yield 후 die 분기 → 사망 애니 태그 부착 후 Halt.",
      "given": {
        "self": {
          "properties": { "Health": 0, "MaxHealth": 100 },
          "tags": ["State.Dead"],
          "position": [0, 0, 0]
        }
      },
      "expect": {
        "status": "Completed",
        "self": { "tags": ["Anim.FullBody.Action.Death"] }
      }
    },
    {
      "name": "idle_player_keeps_looping",
      "description": "ActionIntentType=0 (idle) + Health>0 → brain 은 매 프레임 yield 하며 영구 루프. 하니스 maxFrames 도달 시 status=Waiting.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": { "Health": 100, "MaxHealth": 100, "ActionIntentType": 0 },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 5,
      "expect": { "status": "Waiting" }
    },
    {
      "name": "attack_intent_in_range_dispatches_useskill",
      "description": "ActionIntentType=2(Attack) + Target Hittable + dist≤200 + NextActionFrame=0(쿨다운 OK) → StopMovement + DispatchEventTo(UseSkill, Target). Brain 은 디스패치 후 Jump loop → 다음 Yield 로 진입. maxFrames=2 (Yield 1 회 + body 1 회) 로 1 회 디스패치만 발생.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"},
            "NextActionFrame": 0,
            "IsMoving": 1
          },
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [100, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 0,
            "VelX": 0, "VelY": 0, "VelZ": 0,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"}
          }
        },
        "dispatched": [
          { "eventTag": "Story.Event.Combat.UseSkill", "source": "self", "target": "target" }
        ]
      }
    },
    {
      "name": "attack_intent_out_of_range_chases_target",
      "description": "ActionIntentType=2 + Target Hittable + dist>200 → MoveToward(Target.pos). MoveTargetX/Y/Z 가 Target 좌표로 세팅되고 IsMoving=1 + MoveForce=150. 디스패치는 없음.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"},
            "NextActionFrame": 0
          },
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 100, "MaxHealth": 100 },
          "position": [1000, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 1,
            "MoveTargetX": 1000,
            "MoveTargetY": 0,
            "MoveTargetZ": 0,
            "MoveForce": 150,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"}
          }
        },
        "dispatched": []
      }
    },
    {
      "name": "attack_intent_target_dead_clears_intent",
      "description": "ActionIntentType=2 인 상태에서 Target.Health<=0 → Brain 이 clear_intent 분기 → StopMovement + ActionIntentType=0 + ActionIntentTarget=0 (자동 종료 조건).",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 2,
            "ActionIntentTarget": {"ref": "target"},
            "IsMoving": 1
          },
          "position": [0, 0, 0]
        },
        "target": {
          "archetype": "NPC",
          "properties": { "Health": 0, "MaxHealth": 100 },
          "position": [100, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "ActionIntentType": 0,
            "ActionIntentTarget": 0,
            "IsMoving": 0,
            "VelX": 0, "VelY": 0, "VelZ": 0
          }
        },
        "dispatched": []
      }
    },
    {
      "name": "move_intent_far_moves_toward",
      "description": "ActionIntentType=1(Move) + ActionIntentX/Y/Z 가 현 위치에서 임계 초과 → MoveToward(ix,iy,iz). 도착 판정은 squared 2D 거리 (1000² > 16) → chase 분기 → MoveTarget* 세팅.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 1,
            "ActionIntentX": 1000, "ActionIntentY": 0, "ActionIntentZ": 0
          },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "IsMoving": 1,
            "MoveTargetX": 1000,
            "MoveTargetY": 0,
            "MoveTargetZ": 0,
            "MoveForce": 150,
            "ActionIntentType": 1
          }
        },
        "dispatched": []
      }
    },
    {
      "name": "move_intent_arrived_clears_intent",
      "description": "ActionIntentType=1 인데 현 위치와 목표가 squared 2D 거리 ≤ 16 (4², MovementSystem 의 ArrivalThresholdSq 와 동일) → 도착으로 판단해 StopMovement + ActionIntentType=0 + ActionIntentTarget=0. Z 차이는 무시.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": {
            "Health": 100, "MaxHealth": 100,
            "ActionIntentType": 1,
            "ActionIntentX": 2, "ActionIntentY": 2, "ActionIntentZ": 5000,
            "IsMoving": 1
          },
          "position": [0, 0, 0]
        }
      },
      "maxFrames": 2,
      "expect": {
        "status": "Waiting",
        "self": {
          "properties": {
            "ActionIntentType": 0,
            "ActionIntentTarget": 0,
            "IsMoving": 0,
            "VelX": 0, "VelY": 0, "VelZ": 0
          }
        },
        "dispatched": []
      }
    }
  ]
}
