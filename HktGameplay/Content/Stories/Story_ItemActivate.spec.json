{
  "storyTag": "Story.Event.Item.Activate",
  "description": "ItemActivate 본문: ValidateItemState(1) + ValidateOwnership + 동일 EquipIndex 충돌 아이템 evict + ActivateInSlot. spec runner 가 precondition 미실행 → main body 의 두 SnippetValidate 가 가드 역할. Self.EquipIndex 컬럼이 활성화 슬롯 인덱스를 보유 (JSON 의 ReadProperty EquipIndex).",
  "scenarios": [
    {
      "name": "activate_item_from_bag_into_empty_slot",
      "description": "Self 의 가방 아이템(InBag) 을 EquipIndex=2 슬롯에 활성화. 같은 슬롯 충돌 아이템 없음 → evict_loop 무발화 → ActivateInSlot 으로 ItemState 1→2 + EquipIndex=2. ApplyItemStats 가 AttackPower/Defense 합산. Equippable=1 이라 Stance 도 캐릭터에 복사.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": { "AttackPower": 10, "Defense": 5, "EquipIndex": 2 }
        },
        "target": {
          "archetype": "Item",
          "properties": {
            "ItemState": 1,
            "OwnerEntity": {"ref": "self"},
            "AttackPower": 20,
            "Defense": 10,
            "Equippable": 1,
            "Stance": 12345
          },
          "tags": ["Entity.Item"]
        }
      },
      "expect": {
        "status": "Completed",
        "target": {
          "properties": {
            "ItemState": 2,
            "EquipIndex": 2
          }
        },
        "self": {
          "properties": {
            "AttackPower": 30,
            "Defense": 15,
            "Stance": 12345
          }
        }
      }
    },
    {
      "name": "fail_when_target_state_not_inbag",
      "description": "Target.ItemState=0 (Ground) → SnippetValidateItemState(1) fail.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": { "EquipIndex": 0 }
        },
        "target": {
          "archetype": "Item",
          "properties": {
            "ItemState": 0,
            "OwnerEntity": {"ref": "self"}
          }
        }
      },
      "expect": {
        "status": "Failed"
      }
    },
    {
      "name": "fail_when_target_not_owned_by_self",
      "description": "Target.ItemState=1 OK 지만 OwnerEntity 미설정(0) → SnippetValidateOwnership fail.",
      "given": {
        "self": {
          "archetype": "Character",
          "properties": { "EquipIndex": 0 }
        },
        "target": {
          "archetype": "Item",
          "properties": {
            "ItemState": 1,
            "OwnerEntity": 0
          }
        }
      },
      "expect": {
        "status": "Failed"
      }
    }
  ]
}
