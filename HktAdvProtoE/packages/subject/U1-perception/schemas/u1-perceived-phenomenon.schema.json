{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkt.local/schemas/u1-perceived-phenomenon.schema.json",
  "title": "U1 지각된 현상",
  "description": "한 주체에게 실제로 닿은 것. 원본 10장이 이름만 부르고 형태를 정하지 않았으므로 U1 이 정의한다. 같은 사건도 감각마다 따로 닿으므로 채널이 id 의 일부다 — 원문 「2.4」의 \"시각 주장과 청각 주장이 구분된다\"가 여기서 지켜진다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "phenomenonId",
    "perceiverId",
    "channel",
    "strength",
    "threshold",
    "distance",
    "sensedBy",
    "dampedBy",
    "via",
    "distortion",
    "tags",
    "occurredAtTick",
    "evidenceIds"
  ],
  "properties": {
    "id": { "type": "string" },
    "phenomenonId": { "type": "string" },
    "perceiverId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "channel": {
      "type": "string",
      "enum": ["visual", "audio", "smell", "touch", "aura", "report", "rumor"]
    },
    "strength": { "type": "number", "minimum": 0 },
    "threshold": { "type": "number", "minimum": 0 },
    "distance": { "type": ["number", "null"], "minimum": 0 },
    "sensedBy": { "type": ["string", "null"] },
    "dampedBy": { "type": "array", "items": { "type": "string" } },
    "via": { "type": ["string", "null"] },
    "distortion": { "type": "number", "minimum": 0, "maximum": 1 },
    "tags": { "type": "array", "items": { "type": "string" } },
    "occurredAtTick": { "type": "integer", "minimum": 0 },
    "evidenceIds": { "type": "array", "items": { "type": "string" } }
  }
}
