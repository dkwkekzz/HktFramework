{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkt.local/schemas/v3-input.schema.json",
  "title": "V3 입력",
  "description": "등록할 픽스처·스키마와 실행할 Given-When-Then 시나리오 목록.",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarios"],
  "properties": {
    "schemas": {
      "type": "array",
      "items": { "type": "object" }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "title": { "type": "string", "minLength": 1 },
          "schemaId": { "type": "string", "minLength": 1 },
          "state": { "type": "object" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "given", "when", "then"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "given": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fixture": { "type": "string", "minLength": 1 },
              "state": { "type": "object" }
            }
          },
          "when": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["step"],
              "properties": {
                "step": { "type": "string", "minLength": 1 },
                "params": { "type": "object" },
                "note": { "type": "string" }
              }
            }
          },
          "then": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path", "op"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "path": { "type": "string" },
                "op": {
                  "enum": [
                    "equals",
                    "notEquals",
                    "lessThan",
                    "atMost",
                    "greaterThan",
                    "atLeast",
                    "changed",
                    "unchanged",
                    "present",
                    "absent",
                    "length"
                  ]
                },
                "value": true,
                "at": true,
                "reason": { "type": "string" }
              }
            }
          },
          "seed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["worldSeed"],
            "properties": {
              "worldSeed": { "type": "string", "pattern": "^-?[0-9]+$" },
              "tick": { "type": "integer", "minimum": 0 },
              "subjectId": { "type": "string" },
              "decisionCounter": { "type": "integer", "minimum": 0 }
            }
          },
          "msPerTick": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
