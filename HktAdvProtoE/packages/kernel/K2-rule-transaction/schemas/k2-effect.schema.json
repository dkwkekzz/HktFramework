{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkt.local/schemas/k2-effect.schema.json",
  "title": "K2 효과",
  "description": "세계 설계 원본 15.3 의 EffectSpec — 아홉 연산자뿐이다.",
  "type": "object",
  "required": ["op"],
  "properties": {
    "op": {
      "enum": [
        "add",
        "multiply",
        "set",
        "transfer",
        "attach_tag",
        "remove_tag",
        "create_commitment",
        "breach_commitment",
        "schedule_event"
      ]
    },
    "path": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "value": true,
    "from": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "to": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "amount": { "type": "number", "minimum": 0 },
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tag": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "templateId": { "type": "string", "minLength": 1 },
    "commitmentIdPath": { "type": "string", "minLength": 1 },
    "eventTemplateId": { "type": "string", "minLength": 1 },
    "delayTicks": { "type": "integer", "minimum": 0 }
  }
}
