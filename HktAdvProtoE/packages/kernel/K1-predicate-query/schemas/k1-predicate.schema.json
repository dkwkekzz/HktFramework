{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hkt.local/schemas/k1-predicate.schema.json",
  "title": "K1 조건식",
  "description": "원문 「9」 K1 의 PredicateSpec. 여덟 연산자뿐이며 임의 실행 코드가 들어갈 자리가 없다.",
  "type": "object",
  "required": ["op"],
  "properties": {
    "op": {
      "enum": ["eq", "gt", "lt", "has_tag", "within_distance", "and", "or", "not"]
    },
    "path": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "value": true,
    "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tag": { "type": "string", "minLength": 1 },
    "a": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "b": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "max": { "type": "number", "minimum": 0 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://hkt.local/schemas/k1-predicate.schema.json" }
    },
    "item": { "$ref": "https://hkt.local/schemas/k1-predicate.schema.json" }
  }
}
